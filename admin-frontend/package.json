{
  "name": "admin-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "通用后端管理系统 - 前端（Vue3 + Vite + TypeScript + Element Plus + UnoCSS）",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --fix && stylelint \"src/**/*.{scss,css,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,json,md}\"",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@iconify/vue": "^5.0.0",
    "@vueuse/core": "^13.0.0",
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "element-plus": "^2.9.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.1",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@iconify/json": "^2.2.2",
    "@types/node": "^22.10.5",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "lint-staged": "^15.4.1",
    "prettier": "^3.4.2",
    "sass": "^1.83.0",
    "simple-git-hooks": "^2.11.1",
    "stylelint": "^16.14.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "unocss": "^66.0.0",
    "unplugin-auto-import": "^19.1.0",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
