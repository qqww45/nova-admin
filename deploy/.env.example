# 复制为 .env 后放在服务器 /opt/nova-admin/.env（切勿提交到仓库）
# 说明：CI 只上传 jar 与 compose 文件，不覆盖本文件；改配置在这里改，然后 docker compose up -d

# ---------- 必填 ----------
# JWT 密钥：>= 32 字节随机串（staging/prod 启动时会强校验，默认值直接拒绝启动）
# 生成：openssl rand -base64 48
JWT_SECRET=

# 前端来源（精确匹配，多个用逗号分隔，禁止 *）
CORS_ALLOWED_ORIGINS=https://admin.s.ci64.com

# ---------- 可选 ----------
SPRING_PROFILES_ACTIVE=staging
# 过渡期固定 memory（单实例）；后续接 Redis 改成 redis 并补 REDIS_HOST 等
ADMIN_CACHE_TYPE=memory
# 过渡期日志通道 + 回传验证码，便于验收；正式上线改 email + false
ADMIN_VERIFY_CHANNEL=log
ADMIN_VERIFY_REVEAL_CODE=true
# 仪表盘展示的版本号（CI 可注入 commit 短 SHA）
ADMIN_VERSION=1.0.0
# 后端公网端口
BACKEND_PORT=8080
# 基础镜像（Docker Hub 拉取失败时改国内源）
BASE_IMAGE=eclipse-temurin:21-jre
